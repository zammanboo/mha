# Copy to /etc/mysql-ha.env or create it with scripts/register_base_dir.sh.
# BASE_DIR is where runtime hook scripts and support files are deployed.
BASE_DIR=/opt/mysql-ha

# Percona repository setup target used by install scripts.
PERCONA_SETUP=pdps-84-lts

# systemd service name used by install/restart helpers.
SERVICE_NAME=orchestrator
