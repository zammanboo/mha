[mysqld]
# Change per host.
server_id = 102
report_host = mysql-b
report_port = 3306

bind-address = 0.0.0.0
port = 3306

# GTID based replication.
gtid_mode = ON
enforce_gtid_consistency = ON
log_bin = mysql-bin
log_replica_updates = ON
binlog_format = ROW
binlog_row_image = FULL

# Crash safety.
sync_binlog = 1
innodb_flush_log_at_trx_commit = 1
relay_log_recovery = ON

# Parallel apply.
replica_parallel_workers = 8
replica_preserve_commit_order = ON

# Replica starts protected.
read_only = ON
super_read_only = ON

# Keep binary logs long enough for delayed recovery and failback.
binlog_expire_logs_seconds = 604800

# Semi-sync replication reduces acknowledged transaction loss on unplanned failover.
# It does not replace fencing/quorum and does not by itself prevent split-brain.
# Both plugins are loaded on every node so roles can switch without restart.
plugin-load-add = rpl_semi_sync_source=semisync_source.so
plugin-load-add = rpl_semi_sync_replica=semisync_replica.so
rpl_semi_sync_source_enabled = ON
rpl_semi_sync_replica_enabled = ON
rpl_semi_sync_source_timeout = 1000
rpl_semi_sync_source_wait_for_replica_count = 1

# Recommended for Orchestrator visibility.
performance_schema = ON
